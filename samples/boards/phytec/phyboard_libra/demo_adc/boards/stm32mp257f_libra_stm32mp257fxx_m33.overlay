#include <zephyr/dt-bindings/pwm/pwm.h>

#define STM32_CLOCK_PERIPH_TIM8 0x71C
#define STM32_RESET_PERIPH_TIM8 0x71C

/ {
	
	soc {
		timers8: timers@40210000 {
		    compatible = "st,stm32-timers";
		    reg = <0x40210000 0x400>;
		    resets = <&rctl STM32_RESET(TIM8, STM32_RST)>;
		    interrupts = <118 0>, <119 0>, <120 0>, <121 0>;
		    interrupt-names = "brk", "up", "trg-com", "cc";
		    clocks = <&rcc STM32_CLOCK(TIM8, STM32_CLK)>;
		    st,prescaler = <0>;
		    status = "disabled";
		    
		    pwm8: pwm {
			compatible = "st,stm32-pwm";
			pinctrl-names = "default";
			pinctrl-0 = <&tim8_ch2_pi3>;
			#pwm-cells = <3>;
			status = "disabled";
		    };
		};
	};
	
	
	pwm_fan0: pwm-fan0 {
		pwms = <&pwm8 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
	};
	
	zephyr,user{
		io-channels = <&spi_adc 7>;
	};
};

